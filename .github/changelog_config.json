{
    "mode": "COMMIT",
    "template": "#{{CHANGELOG}}",
    "commit_template": "- #{{TITLE}} ([#{{MERGE_SHA}}](https://github.com/#{{OWNER}}/#{{REPO}}/commit/#{{MERGE_SHA}}))",
    "categories": [
        {
            "title": "## Features",
            "labels": ["feat"]
        },
        {
            "title": "## Bug Fixes",
            "labels": ["fix"]
        },
        {
            "title": "## Dependency Updates",
            "labels": ["deps"]
        }
    ],
    "label_extractor": [
        {
            "pattern": "^(feat|fix)(?:\\([^)]+\\))?!?:.*$",
            "target": "$1",
            "on_property": "title"
        },
        {
            "pattern": "^deps(?:\\([^)]+\\))?!?:.*$",
            "target": "deps",
            "on_property": "title"
        }
    ],
    "empty_template": "# Release Notes\n\nInternal maintenance and minor updates.",
    "options": {
        "commits_as_entries": true
    }
}
